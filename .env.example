# Base URL of the signal-cli-rest-api instance this server talks to.
# NOTE: signal-cli-rest-api has NO built-in auth or TLS. Keep it firewalled,
# or put it behind a reverse proxy that adds TLS/auth. Never expose it publicly.
SIGNAL_API_URL=http://localhost:8080

# Default account number (international format, e.g. +15551234567) used when a
# tool call omits its `number` argument. Leave empty to require `number` always.
SIGNAL_NUMBER=

# MCP transport to use:
#   stdio - standard input/output (default, used by Claude Desktop / opencode / MetaMCP CLI)
#   http  - Streamable HTTP server (needed for MetaMCP remote hosting)
SIGNAL_TRANSPORT=stdio

# HTTP transport bind settings (only used when SIGNAL_TRANSPORT=http)
# Loopback by default; change HOST only to deliberately expose the endpoint.
HOST=127.0.0.1
PORT=3000

# Maximum HTTP request body size in bytes. POST bodies over the limit get a
# 413 before the server parses anything. Raise it only for clients that send
# unusually large tool arguments. Default: 10485760 (10 MiB).
SIGNAL_MAX_BODY_BYTES=10485760

# Optional bearer token. When set, the MCP HTTP endpoint requires every request
# to carry "Authorization: Bearer <token>". Leave empty to disable auth.
SIGNAL_API_TOKEN=

# Host header values the HTTP endpoint accepts (DNS rebinding protection), as a
# comma-separated list compared exactly, port included, e.g.
# "mcp.example.com,mcp.example.com:443". Leave empty to derive the list from
# HOST and PORT. Set it when a reverse proxy or a remote gateway such as
# MetaMCP forwards requests under its own hostname.
SIGNAL_ALLOWED_HOSTS=

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Opt-in recipient allowlist for send_message. A comma-separated list of phone
# numbers and/or group IDs. When set, send_message refuses any recipient that is
# not on the list. Leave empty to allow sending to anyone.
SIGNAL_ALLOWED_RECIPIENTS=
