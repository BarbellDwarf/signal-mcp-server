{
  "name": "signal-api-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol (MCP) server for Signal, backed by a running signal-cli-rest-api instance.",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "bin": {
    "signal-api-mcp": "dist/index.js"
  },
  "files": [
    "dist/index.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "signal",
    "signal-cli",
    "signal-cli-rest-api",
    "llm",
    "agent"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^16.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
